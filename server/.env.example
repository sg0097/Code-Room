# Set these as environment variables on your host (Render: Environment tab).
GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
SESSION_SECRET=generate-a-long-random-string
NODE_ENV=production

# Optional: TURN relay so calls work on strict office/college networks
# TURN_URL=turn:your-turn-host:3478,turns:your-turn-host:5349
# TURN_USERNAME=
# TURN_CREDENTIAL=

# Local testing only. Never enable in production.
# DEV_LOGIN=true

# Postgres connection string (Neon, Supabase, Render Postgres…). Leave unset locally
# to use the built-in PGlite database stored in server/data/.
# DATABASE_URL=postgres://user:pass@host/db?sslmode=require
# PGSSL=false   # only for a local Postgres without TLS
